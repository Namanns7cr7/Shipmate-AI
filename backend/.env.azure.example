# ── Azure deployment env (feat/azure-deploy) ────────────────────────────────
# Copy to the Container App's app settings. This branch differs from main ONLY
# in deployment config: main runs Bedrock (local/demo); here the LLM provider is
# flipped to Azure OpenAI so there's no ADA/AWS dependency in the cloud.
#
#   az containerapp up --name shipmate-api --source backend  (uses backend/Dockerfile)

# Flip the provider — this is the one functional difference from main.
SHIPMATE_LLM_PROVIDER=azure

# Azure OpenAI (the openai SDK's AzureOpenAI client drives forced tool-calling).
# Real resource: 'shipmate-aoai' in southeastasia — smart=gpt-4.1, fast=gpt-4.1-mini.
# The API key is NOT in this file by design; pull it from Key Vault / app settings.
AZURE_OPENAI_ENDPOINT=https://shipmate-aoai.openai.azure.com/
AZURE_OPENAI_API_KEY=<from Key Vault — never commit>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_SMART=shipmate-smart
AZURE_OPENAI_DEPLOYMENT_FAST=shipmate-fast

# GitHub OAuth — callback must match the deployed frontend origin.
GITHUB_CLIENT_ID=<oauth app client id>
GITHUB_CLIENT_SECRET=<oauth app client secret>
GITHUB_REDIRECT_URI=https://<your-swa-host>/github/callback

# Production hardening.
ENVIRONMENT=production          # disables /docs, /redoc, /openapi.json
ENABLE_HSTS=true                # safe — Container Apps terminates TLS
ALLOWED_ORIGINS=https://<your-swa-host>

# Durable state. /tmp is wiped on container restart; point at a mounted, ideally
# ENCRYPTED volume — this dir holds the session vault (the one place a token
# rests at rest).
SHIPMATE_STORE_DIR=/home/site/data

# Webhook auth (if GitHub webhooks are configured).
GITHUB_WEBHOOK_SECRET=<strong secret>

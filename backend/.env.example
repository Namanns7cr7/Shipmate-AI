# ShipMate AI — Backend Environment Variables Template

# ============================================================================
# GitHub OAuth Configuration (REQUIRED for GitHub integration)
# ============================================================================
# 1. Go to https://github.com/settings/developers/oauth-apps
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: ShipMate AI
#    - Homepage URL: http://localhost:8000 (dev) or your domain
#    - Authorization callback URL: http://localhost:5173/github/callback (dev)
# 4. Copy Client ID and Client Secret below:

GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback

# ============================================================================
# GitHub App Configuration (Optional - for advanced features)
# ============================================================================
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# LLM provider for prose-field enhancement (PlanForge / GuardRail / TestPilot)
# ============================================================================
# `bedrock` = call AWS Bedrock Converse API to rewrite milestone descriptions,
#             security recommendations, suggested-test prose, etc.
# Anything else (or unset) = pure heuristic mode, no network calls. Numeric
# scores and verdicts are ALWAYS deterministic regardless of this setting.
LLM_PROVIDER=bedrock

# ─ AWS Bedrock (active when LLM_PROVIDER=bedrock) ───────────────────────────
# Burner account Pharma-ASIN-Enrich-9 (788356290950). Refresh creds before
# launching the backend:
#   ada credentials update --account=788356290950 \
#     --role=IibsAdminAccess-DO-NOT-DELETE --provider=conduit --once
# boto3 picks up the default profile at ~/.aws/credentials automatically; no
# AWS_PROFILE env var needed.
#
# Defaults use cross-region inference profile IDs (`us.*`). The newer Claude
# generation (Sonnet 4.6, Haiku 4.5) doesn't support on-demand throughput
# directly; Bedrock routes those calls through inference profiles.
AWS_REGION=us-west-2
BEDROCK_MODEL_SMART=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ─ Azure OpenAI (kept as a placeholder until subscription region unblocks) ──
# Currently unused; the codebase routes through bedrock_provider.py only.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================================================
# Azure Storage & Database
# ============================================================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;
AZURE_STORAGE_CONTAINER_NAME=shipmate-reports
AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://...;AccountKey=...;

# ============================================================================
# Azure Application Insights (Telemetry)
# ============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;

# ============================================================================
# Azure Key Vault (optional)
# ============================================================================
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# ============================================================================
# General Configuration
# ============================================================================
ENVIRONMENT=development
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
LOG_LEVEL=INFO

# ============================================================================
# Database Connection (for future use)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost/shipmate_db
FRONTEND_URL=http://localhost:5173
